{
  "name": "typescript",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "main": "tsx index.ts",
    "check:dependency-age": "tsx scripts/check-dependency-age.ts",
    "format": "oxfmt",
    "lint": "oxlint .",
    "fallow": "fallow",
    "test": "vitest",
    "test:openapi": "vitest run openapi/openapi.test.ts",
    "openapi:generate": "tsx openapi/generate.ts",
    "db:openapi:generate": "drizzle-kit generate --config openapi/drizzle.config.ts",
    "db:openapi:migrate": "drizzle-kit migrate --config openapi/drizzle.config.ts",
    "scan": "trivy fs --scanners vuln,secret,misconfig --skip-files \"node_modules/**/*.json,node_modules/**/Dockerfile\" .",
    "coverage": "vitest run --coverage --coverage.provider=istanbul --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "fallow:each": "for c in */.fallowrc.json; do d=$(dirname \"$c\"); echo \"== $d\"; cov=\"\"; [ -f coverage/coverage-final.json ] && cov=\"--coverage $PWD/coverage/coverage-final.json\"; fallow --root \"$d\" $cov --summary || s=1; done; exit ${s:-0}"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@platformatic/flame": "^1.6.0",
    "@temporalio/testing": "^1.21.1",
    "@testcontainers/kafka": "^12.0.1",
    "@testcontainers/rabbitmq": "^12.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-istanbul": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.31.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.9.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "@testcontainers/redis": "^12.0.0",
    "amqplib": "^2.0.1",
    "body-parser": "^2.2.0",
    "camelcase": "^5.3.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.5.8",
    "js-yaml": "4.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "js-yaml": "4.3.2"
  }
}
