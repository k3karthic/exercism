{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "index.ts",
    "concurrency/async.ts",
    "cpu_memory_visualization/ex_*.ts",
    "debugger/debugger_test.ts",
    "durable_execution/client.ts",
    "durable_execution/worker.ts",
    "grpc/client.ts",
    "grpc/server.ts",
    "kafka/app.ts",
    "keycloak/app.ts",
    "opentelemetry/app.ts",
    "opentelemetry/service-2-process.ts",
    "parallelism/cluster.ts",
    "rabbitmq/app.ts",
    "testcontainers/redis.ts",
    "unix_domain_sockets/client.ts",
    "unix_domain_sockets/server.ts",
    "openapi/client_driver.ts",
    "openapi/drizzle.config.ts",
    "openapi/generate.ts",
    "openapi/server.ts",
    "openapi/server-adapters/*.cjs",
    "openapi/server-adapters/*.ts",
    "scripts/check-dependency-age.ts"
  ],
  "ignoreDependencies": [
    "@platformatic/flame",
    "body-parser",
    "camelcase",
    "cookie-parser",
    "cors",
    "express-openapi-validator",
    "js-yaml",
    "winston"
  ],
  "ignoreFindings": ["openapi/server-adapters/**"],
  "ignorePatterns": ["**/generated/**"],
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 15,
    "maxCrap": 30,
    "crapRefactorBand": 5,
    "maxUnitSize": 50,
    "ignore": ["cpu_memory_visualization/ex_*.ts"]
  }
}
